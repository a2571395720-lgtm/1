{
  "name": "jobpilot-desktop",
  "productName": "JobPilot",
  "version": "1.0.0",
  "description": "本地优先的求职桌面助手：档案、简历和申请队列。",
  "author": "JobPilot",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "prepack": "node -e \"require('electron')\"",
    "pack": "electron-builder --dir --win --x64 --publish never",
    "predist": "node -e \"require('electron')\"",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "@playwright/test": "1.63.0",
    "jsdom": "30.1.0"
  },
  "build": {
    "appId": "com.jobpilot.desktop",
    "productName": "JobPilot",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": { "output": "../artifacts/desktop" },
    "files": ["*.cjs", "ui/**/*", "assets/**/*", "package.json", "!playwright.config.cjs"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico",
      "artifactName": "JobPilot-Setup-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "JobPilot",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052"
    }
  }
}
